---
// StaleBanner — shows a warning when data is older than 7 days.
// Hidden by default; client script unhides it if stale.
---

<div
  id="stale-banner"
  class="hidden mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-4"
  role="alert"
  aria-live="polite"
>
  <div class="flex items-start gap-3 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-800 dark:border-amber-600 dark:bg-amber-900/30 dark:text-amber-200">
    <!-- Warning icon -->
    <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86l-8.6 14.9A1 1 0 0 0 2.56 20.5h18.88a1 1 0 0 0 .87-1.74l-8.6-14.9a1 1 0 0 0-1.74 0z" />
    </svg>
    <div>
      <p class="font-semibold">Dados podem estar desatualizados</p>
      <p id="stale-banner-msg" class="mt-1">
        Ultima atualizacao: <span id="stale-date">—</span>.
        Verifique as taxas atuais em
        <a
          href="https://cf.coop.br"
          target="_blank"
          rel="noopener noreferrer"
          class="underline font-medium hover:text-amber-900 dark:hover:text-amber-100"
        >cf.coop.br</a>.
      </p>
    </div>
  </div>
</div>

<script>
  import { loadLastUpdated, isDataStale } from '../lib/data-loader.js';
  import { formatDate } from '../lib/formatters.js';

  async function checkStale() {
    try {
      // Derive the base URL from the current page path
      const base = import.meta.env.BASE_URL;
      const data = await loadLastUpdated(base.replace(/\/$/, ''));
      if (!data) return;

      if (isDataStale(data, 7)) {
        const banner = document.getElementById('stale-banner');
        const dateEl = document.getElementById('stale-date');
        if (banner) banner.classList.remove('hidden');
        if (dateEl && data.timestamp) {
          dateEl.textContent = formatDate(data.timestamp);
        }
      }
    } catch (err) {
      console.warn('StaleBanner: could not check data freshness', err);
    }
  }

  checkStale();
</script>
