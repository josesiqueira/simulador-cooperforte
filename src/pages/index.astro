---
import Layout from '../layouts/Layout.astro';
import StaleBanner from '../components/StaleBanner.astro';
const base = import.meta.env.BASE_URL;
// Ensure base ends with /
const baseUrl = base.endsWith('/') ? base : base + '/';
---

<Layout title="Simulador Cooperforte — Taxas e Simulacoes">
  <StaleBanner />

  <!-- Hero -->
  <section class="text-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-cooperforte/10 mb-6">
        <svg class="w-8 h-8 text-cooperforte" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="1" x2="12" y2="23"></line>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--text-primary)] mb-4">
        Simulador Cooperforte
      </h1>
      <p class="text-lg text-[var(--text-secondary)] max-w-xl mx-auto">
        Compare investimentos e emprestimos da Cooperforte com dados atualizados do Banco Central.
      </p>
    </div>
  </section>

  <!-- Live Dashboard Cards -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
    <div id="dashboard-cards" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Selic -->
      <div class="relative overflow-hidden rounded-xl border border-[var(--border-color)] bg-[var(--surface-card)] p-5 transition-shadow hover:shadow-lg">
        <div class="absolute top-0 right-0 w-20 h-20 -mr-4 -mt-4 rounded-full bg-cooperforte/5"></div>
        <p class="text-xs font-medium text-[var(--text-secondary)] uppercase tracking-wider mb-2">Selic Meta</p>
        <p class="text-3xl font-bold text-[var(--text-primary)]" id="dash-selic">--,--%</p>
        <p class="text-xs text-[var(--text-secondary)] mt-1">a.a.</p>
      </div>

      <!-- CDI -->
      <div class="relative overflow-hidden rounded-xl border border-[var(--border-color)] bg-[var(--surface-card)] p-5 transition-shadow hover:shadow-lg">
        <div class="absolute top-0 right-0 w-20 h-20 -mr-4 -mt-4 rounded-full bg-cooperforte/5"></div>
        <p class="text-xs font-medium text-[var(--text-secondary)] uppercase tracking-wider mb-2">CDI</p>
        <p class="text-3xl font-bold text-[var(--text-primary)]" id="dash-cdi">--,--%</p>
        <p class="text-xs text-[var(--text-secondary)] mt-1">a.a.</p>
      </div>

      <!-- TR -->
      <div class="relative overflow-hidden rounded-xl border border-[var(--border-color)] bg-[var(--surface-card)] p-5 transition-shadow hover:shadow-lg">
        <div class="absolute top-0 right-0 w-20 h-20 -mr-4 -mt-4 rounded-full bg-cooperforte/5"></div>
        <p class="text-xs font-medium text-[var(--text-secondary)] uppercase tracking-wider mb-2">TR</p>
        <p class="text-3xl font-bold text-[var(--text-primary)]" id="dash-tr">--,--%</p>
        <p class="text-xs text-[var(--text-secondary)] mt-1">a.m.</p>
      </div>

      <!-- Last Updated -->
      <div class="relative overflow-hidden rounded-xl border border-[var(--border-color)] bg-[var(--surface-card)] p-5 transition-shadow hover:shadow-lg">
        <div class="absolute top-0 right-0 w-20 h-20 -mr-4 -mt-4 rounded-full bg-cooperforte/5"></div>
        <p class="text-xs font-medium text-[var(--text-secondary)] uppercase tracking-wider mb-2">Atualizado em</p>
        <p class="text-2xl font-bold text-[var(--text-primary)]" id="dash-updated">--/--/----</p>
        <p class="text-xs text-[var(--text-secondary)] mt-1">taxas Cooperforte</p>
      </div>
    </div>
  </div>

  <!-- Simulator Link Cards -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Investimentos -->
      <a
        href={`${baseUrl}investimentos/`}
        class="group block rounded-xl border border-[var(--border-color)] bg-[var(--surface-card)] p-6 transition-all hover:shadow-xl hover:border-cooperforte/40 hover:-translate-y-1"
      >
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-cooperforte/10 flex items-center justify-center group-hover:bg-cooperforte/20 transition-colors">
            <svg class="w-6 h-6 text-cooperforte" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-bold text-[var(--text-primary)] mb-2 group-hover:text-cooperforte transition-colors">
              Simulador de Investimentos
            </h2>
            <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
              RDC-i, RDC-q, RDC-sq, LFC Pre, LFC Pos — compare rendimentos com cenarios Selic, sobras e imposto de renda.
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-cooperforte/10 text-cooperforte font-medium">RDC</span>
              <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 font-medium">LFC</span>
              <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 font-medium">Sobras</span>
              <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300 font-medium">Cenarios</span>
            </div>
          </div>
        </div>
      </a>

      <!-- Emprestimos -->
      <a
        href={`${baseUrl}emprestimos/`}
        class="group block rounded-xl border border-[var(--border-color)] bg-[var(--surface-card)] p-6 transition-all hover:shadow-xl hover:border-cooperforte/40 hover:-translate-y-1"
      >
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-cooperforte/10 flex items-center justify-center group-hover:bg-cooperforte/20 transition-colors">
            <svg class="w-6 h-6 text-cooperforte" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <div>
            <h2 class="text-lg font-bold text-[var(--text-primary)] mb-2 group-hover:text-cooperforte transition-colors">
              Simulador de Emprestimos
            </h2>
            <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
              Consignado, MultiCredito, Credito Garantido, CredCooper40 — compare parcelas, CET, IOF e custo com sobras.
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-cooperforte/10 text-cooperforte font-medium">Consignado</span>
              <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300 font-medium">CET</span>
              <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300 font-medium">IOF</span>
              <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 font-medium">Sobras</span>
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>

  <script>
    import { fetchSelic, fetchCDI, fetchTR } from '../lib/bcb-api.js';
    import { loadLastUpdated } from '../lib/data-loader.js';
    import { formatPercent, formatDate } from '../lib/formatters.js';

    async function populateDashboard() {
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');

      // Fetch all indicators in parallel
      const [selic, cdi, tr, lastUpdated] = await Promise.all([
        fetchSelic(),
        fetchCDI(),
        fetchTR(),
        loadLastUpdated(base),
      ]);

      // Selic
      const selicEl = document.getElementById('dash-selic');
      if (selicEl && selic && selic.valor) {
        const val = parseFloat(selic.valor.replace(',', '.'));
        selicEl.textContent = formatPercent(val);
      }

      // CDI
      const cdiEl = document.getElementById('dash-cdi');
      if (cdiEl && cdi && cdi.valor) {
        const val = parseFloat(cdi.valor.replace(',', '.'));
        cdiEl.textContent = formatPercent(val, 3);
      }

      // TR
      const trEl = document.getElementById('dash-tr');
      if (trEl && tr && tr.valor) {
        const val = parseFloat(tr.valor.replace(',', '.'));
        trEl.textContent = formatPercent(val, 3);
      }

      // Last Updated
      const updEl = document.getElementById('dash-updated');
      if (updEl && lastUpdated && lastUpdated.timestamp) {
        updEl.textContent = formatDate(lastUpdated.timestamp);
      }
    }

    populateDashboard();
  </script>
</Layout>
